{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://pgnearme.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://pgnearme.onrender.com/uploads/:path*"
    }
  ]
}
